---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "尚南 Nan Shang · 遥感 · 地理空间AI",
  description = "尚南（Nan Shang），LSU 地理学博士，Drone Institute 首席科学家。遥感 · 地理空间 AI · 系统工程。 / Ph.D. in Geography (LSU). Chief Scientist, Drone Institute. Remote Sensing · Geospatial AI · Systems Engineering.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nan Shang 尚南" />
    <meta name="keywords" content="Nan Shang, 尚南, Remote Sensing, 遥感, Geospatial AI, 地理空间人工智能, GIS, LiDAR, UAV, Deep Learning, LSU, Drone Institute" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href="https://leibowivz.github.io/nan-shang-site/" />
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <!-- 水墨渲染画布 -->
    <canvas id="ink-canvas" aria-hidden="true"></canvas>
    <slot />
  </body>
  <script is:inline>
    (function() {
      const canvas = document.getElementById('ink-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let splashes = [];
      let animId = null;

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = document.documentElement.scrollHeight;
      }
      resize();
      window.addEventListener('resize', () => { resize(); });

      // 水墨飞溅粒子
      function createSplash(x, y) {
        const count = 6 + Math.floor(Math.random() * 8);
        const baseR = 4 + Math.random() * 6;
        const baseAngle = Math.random() * Math.PI * 2;
        for (let i = 0; i < count; i++) {
          const angle = baseAngle + (i / count) * Math.PI * 2 + (Math.random() - 0.5) * 0.8;
          const dist = baseR * (0.6 + Math.random() * 1.2);
          const life = 0.8 + Math.random() * 1.2;
          splashes.push({
            x: x + Math.cos(angle) * dist * 0.3,
            y: y + Math.sin(angle) * dist * 0.3,
            vx: Math.cos(angle) * dist * 1.8,
            vy: Math.sin(angle) * dist * 1.8,
            r: 1.5 + Math.random() * 4,
            maxR: baseR * (0.5 + Math.random() * 0.8),
            opacity: 0.25 + Math.random() * 0.35,
            life: life,
            age: 0,
            color: Math.random() < 0.12 ? '139,26,26' : '26,26,28', // 偶有朱砂粒子
          });
        }
        // 中心洇墨圈
        for (let i = 0; i < 2; i++) {
          splashes.push({
            x: x + (Math.random() - 0.5) * 4,
            y: y + (Math.random() - 0.5) * 4,
            vx: 0, vy: 0,
            r: 1,
            maxR: 18 + Math.random() * 16,
            opacity: 0.12 + Math.random() * 0.10,
            life: 1.5 + Math.random() * 0.6,
            age: 0,
            color: '26,26,28',
          });
        }
        if (!animId) animId = requestAnimationFrame(animate);
      }

      function animate(ts) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        splashes = splashes.filter(s => {
          s.age += 0.016;
          const progress = s.age / s.life;
          if (progress >= 1) return false;
          s.x += s.vx * 0.016;
          s.y += s.vy * 0.016;
          s.vx *= 0.92;
          s.vy *= 0.92;
          s.r += (s.maxR - s.r) * 0.08;
          // 水墨洇开曲线：先浓后淡
          const alpha = s.opacity * (1 - Math.pow(progress, 0.55));
          // 有机形状模拟
          const jitter = 1 + Math.sin(s.age * 12 + s.x * 0.3) * 0.12 + Math.cos(s.age * 8 + s.y * 0.3) * 0.1;
          const r = s.r * jitter;
          ctx.beginPath();
          ctx.arc(s.x, s.y, r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${s.color},${alpha.toFixed(3)})`;
          ctx.fill();
          // 淡色羽化外圈
          if (r > 6) {
            ctx.beginPath();
            ctx.arc(s.x, s.y, r * 1.4, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${s.color},${(alpha * 0.25).toFixed(3)})`;
            ctx.fill();
          }
          return true;
        });
        if (splashes.length > 0) {
          animId = requestAnimationFrame(animate);
        } else {
          animId = null;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }

      document.addEventListener('click', function(e) {
        createSplash(e.pageX, e.pageY);
      });

      // 页面滚动时同步 canvas 高度
      window.addEventListener('scroll', function() {
        const h = document.documentElement.scrollHeight;
        if (canvas.height < h) canvas.height = h;
      });
    })();
  </script>
</html>

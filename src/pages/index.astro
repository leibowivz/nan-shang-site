      <div class="container">
        <h2 class="section-title">
          <span class="title-bracket">// </span>Systems I Build
        </h2>
        <div class="systems">
          <div class="system-card">
            <div class="system-header">
              <div class="system-status">
                <span class="status-indicator">●</span>

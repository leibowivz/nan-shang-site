          <div class="stat-value">10+</div>
          <div class="stat-label">PRODUCTION_SYSTEMS</div>
        </div>
        <div class="stat">
          <div class="stat-value">24/7</div>
          <div class="stat-label">OPERATIONAL_MONITOR</div>
        </div>
        <div class="stat">

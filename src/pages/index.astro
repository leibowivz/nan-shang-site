    }

    .card-status {
      font-size: 0.75rem;
      color: var(--green);
      text-shadow: 0 0 5px var(--green);
    }

    .card-title {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--black);
      font-family: var(--font-heading);
      letter-spacing: 0.15em;

            </a>
          </div>
          <div class="cyber-card contact-card">
            <div class="contact-label">CODE_REPOSITORY</div>
            <a href="https://github.com/leibowivz" target="_blank" class="contact-value">
              github.com/leibowivz
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-left">
          <div class="footer-name">NAN_SHANG_PHD</div>
          <div class="footer-role">CHIEF_SCIENTIST_&_FOUNDING_ENGINEER :: DRONE_INSTITUTE</div>
        </div>
        <div class="footer-right">
          <a href="https://github.com/leibowivz" target="_blank">[GITHUB]</a>
          <a href="https://scholar.google.com/citations?user=TcDAyj0AAAAJ&hl=en" target="_blank">[SCHOLAR]</a>
        </div>
      </div>

---
import Base from "../layouts/Base.astro";
---

<Base>
  <!-- 墨汁晕染效果 -->
  <div class="ink-drop ink-drop-1"></div>
  <div class="ink-drop ink-drop-2"></div>

  <!-- Navigation -->
  <nav class="nav">
    <div class="nav-container">
      <div class="logo">
        <!-- 篆刻印章：尚南之印 -->
        <svg class="seal" width="36" height="36" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <!-- 外框 -->
          <rect x="2" y="2" width="116" height="116" fill="white" stroke="black" stroke-width="6"/>
          <!-- 内框 -->
          <rect x="10" y="10" width="100" height="100" fill="none" stroke="black" stroke-width="2.5"/>
          
          <!-- 右列：尚（上）南（下） -->
          <text x="85" y="50" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">尚</text>
          <text x="85" y="98" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">南</text>
          
          <!-- 左列：之（上）印（下） -->
          <text x="35" y="50" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">之</text>
          <text x="35" y="98" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">印</text>
        </svg>
        <span class="glitch" data-text="NAN SHANG">NAN SHANG</span>
      </div>
      <div class="nav-links">
        <a href="#work">WORK</a>
        <a href="#research">RESEARCH</a>
        <a href="#contact">CONTACT</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        CHIEF SCIENTIST & FOUNDING ENGINEER · DRONE INSTITUTE
      </div>
      <h1 class="hero-title">
        <span class="glitch-text" data-text="I BUILD SYSTEMS">I BUILD SYSTEMS</span><br/>
        <span class="cyber-gradient">THAT LAST.</span>
      </h1>
      <p class="hero-subtitle">
        Not systems that impress at first glance,<br/>
        but systems that remain quiet, stable, and correct<br/>
        after the novelty fades.
      </p>
      <div class="hero-actions">
        <a href="#work" class="btn btn-primary">
          VIEW SYSTEMS
        </a>
        <a href="https://scholar.google.com/citations?user=TcDAyj0AAAAJ&hl=en" 
           target="_blank" class="btn btn-secondary">
          RESEARCH
        </a>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="overview-section">
    <div class="container">
      <div class="overview-content">
        <p class="overview-text">
          I design and operate production-grade geospatial and AI systems.<br/><br/>
          My work sits at the intersection of <strong>remote sensing research</strong>, 
          <strong>geospatial analytics</strong>, and <strong>system architecture</strong>. 
          I focus on building systems that take spatial data—often noisy, incomplete, 
          and operationally constrained—and turn it into outputs that can be trusted 
          in real decision-making contexts.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="main">

    <!-- Philosophy -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">
          <span class="section-marker">&gt;&gt;</span> PHILOSOPHY
          <span class="section-seal">哲学</span>
        </h2>
        <div class="grid-2">
          <div class="cyber-card">
            <div class="card-header">
              <span class="card-id">01</span>
            </div>
            <h3 class="card-title">PRODUCTION IS THE BENCHMARK</h3>
            <p class="card-text">
              A system is only meaningful if it continues to behave correctly after deployment. 
              I design systems to fail visibly rather than silently, to support iteration without 
              destabilization, and to remain interpretable to engineers and operators.
            </p>
          </div>
          <div class="cyber-card">
            <div class="card-header">
              <span class="card-id">02</span>
            </div>
            <h3 class="card-title">CONSTRAINTS SHAPE ARCHITECTURE</h3>
            <p class="card-text">
              Latency, throughput, cost envelopes, and operational friction are architectural facts. 
              I treat these constraints as inputs to design decisions, making trade-offs explicit 
              so systems can be reasoned about and maintained over time.
            </p>
          </div>
          <div class="cyber-card">
            <div class="card-header">
              <span class="card-id">03</span>
            </div>
            <h3 class="card-title">DEPLOYMENT REVEALS ASSUMPTIONS</h3>
            <p class="card-text">
              Research does not end at deployment. I design feedback loops that surface failure modes, 
              quantify drift, and allow systems to improve without eroding trust or stability.
            </p>
          </div>
          <div class="cyber-card">
            <div class="card-header">
              <span class="card-id">04</span>
            </div>
            <h3 class="card-title">DATA QUALITY COMPOUNDS</h3>
            <p class="card-text">
              Long-term system advantage comes from disciplined data practices. I build pipelines 
              where ingestion, annotation, quality control, monitoring, retraining, and rollback 
              strategies reinforce one another.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Engineering -->
    <section class="section" id="work">
      <div class="container">
        <h2 class="section-title">
          <span class="section-marker">&gt;&gt;</span> ENGINEERING
          <span class="section-seal">工程</span>
        </h2>
        <div class="systems">
          <div class="cyber-card system-card">
            <div class="card-header">
              <span class="card-id">01</span>
            </div>
            <h3 class="card-title">END TO END GEOSPATIAL PIPELINES</h3>
            <p class="card-text">
              I build pipelines that cover the full lifecycle of spatial data, from ingestion 
              and normalization to processing, verification, reporting, and delivery. These 
              systems are designed to be repeatable, auditable, and resilient under scale.
            </p>
          </div>

          <div class="cyber-card system-card">
            <div class="card-header">
              <span class="card-id">02</span>
            </div>
            <h3 class="card-title">MULTIMODAL REMOTE SENSING WORKFLOWS</h3>
            <p class="card-text">
              I work across RGB imagery, thermal and infrared data, and derived spatial layers. 
              The focus is on extracting actionable signals while controlling uncertainty and 
              false positives in operational environments.
            </p>
          </div>

          <div class="cyber-card system-card">
            <div class="card-header">
              <span class="card-id">03</span>
            </div>
            <h3 class="card-title">VERIFICATION AND QUALITY CONTROL SYSTEMS</h3>
            <p class="card-text">
              Spatial systems often fail quietly through projection errors, unit mismatches, 
              alignment drift, or metadata assumptions. I build verification layers—automated 
              and human-in-the-loop—that make these failures observable and traceable.
            </p>
          </div>

          <div class="cyber-card system-card">
            <div class="card-header">
              <span class="card-id">04</span>
            </div>
            <h3 class="card-title">SECURE DATA DELIVERY ARCHITECTURES</h3>
            <p class="card-text">
              I design delivery systems with clear permission boundaries, multi-tenant access 
              control, and lifecycle management. Systems built to support continuous operation, 
              repeatable results, and controlled iteration under real-world constraints.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Research -->
    <section class="section" id="research">
      <div class="container">
        <h2 class="section-title">
          <span class="section-marker">&gt;&gt;</span> RESEARCH
          <span class="section-seal">研究</span>
        </h2>
        <div class="research-content">
          <p class="card-text">
            My research background is in <strong>remote sensing and geospatial analysis</strong>, 
            and it directly informs the systems I build today.
          </p>
          <p class="card-text">
            My peer-reviewed work addresses questions that recur in production systems:
          </p>
          <ul class="cyber-list">
            <li><span class="list-marker">▸</span> How spatial measurements behave under noise and scale</li>
            <li><span class="list-marker">▸</span> How resolution, alignment, and representation affect downstream inference</li>
            <li><span class="list-marker">▸</span> How to reason about uncertainty in derived spatial products</li>
          </ul>
          <p class="card-text">
            These research insights shape practical decisions in system design, including data 
            preprocessing, model selection, validation strategies, and quality control thresholds.
          </p>
          <p class="card-text">
            I have authored and co-authored publications in journals and conferences, contributing 
            methods and analytical frameworks that are now embedded in production pipelines.
          </p>
          <a href="https://scholar.google.com/citations?user=TcDAyj0AAAAJ&hl=en" 
             target="_blank" class="cyber-link">
            VIEW PUBLICATIONS →
          </a>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section" id="contact">
      <div class="container">
        <h2 class="section-title">
          <span class="section-marker">&gt;&gt;</span> CONTACT
          <span class="section-seal">联系</span>
        </h2>
        <div class="contact-grid">
          <div class="cyber-card contact-card">
            <div class="contact-label">EMAIL</div>
            <a href="mailto:nan.shang@droneinstitute.ai" class="contact-value">
              nan.shang@droneinstitute.ai
            </a>
          </div>
          <div class="cyber-card contact-card">
            <div class="contact-label">PERSONAL</div>
            <a href="mailto:sn1514826@gmail.com" class="contact-value">
              sn1514826@gmail.com
            </a>
          </div>
          <div class="cyber-card contact-card">
            <div class="contact-label">GITHUB</div>
            <a href="https://github.com/leibowivz" target="_blank" class="contact-value">
              github.com/leibowivz
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-left">
          <div class="footer-name">
            NAN SHANG
            <!-- 篆刻印章：尚南之印 -->
            <svg class="seal seal-footer" width="28" height="28" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
              <!-- 外框 -->
              <rect x="2" y="2" width="116" height="116" fill="white" stroke="black" stroke-width="6"/>
              <!-- 内框 -->
              <rect x="10" y="10" width="100" height="100" fill="none" stroke="black" stroke-width="2.5"/>
              
              <!-- 右列：尚（上）南（下） -->
              <text x="85" y="50" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">尚</text>
              <text x="85" y="98" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">南</text>
              
              <!-- 左列：之（上）印（下） -->
              <text x="35" y="50" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">之</text>
              <text x="35" y="98" font-size="42" font-weight="900" text-anchor="middle" fill="black" font-family="'ZCOOL XiaoWei', 'STFangsong', 'FangSong', 'Noto Serif SC', serif" stroke="black" stroke-width="1.5">印</text>
            </svg>
          </div>
          <div class="footer-role">CHIEF SCIENTIST & FOUNDING ENGINEER</div>
        </div>
        <div class="footer-right">
          <a href="https://github.com/leibowivz" target="_blank">GITHUB</a>
          <a href="https://scholar.google.com/citations?user=TcDAyj0AAAAJ&hl=en" target="_blank">SCHOLAR</a>
        </div>
      </div>
      <div class="footer-timestamp">
        UPDATED: 2026.02.09
      </div>
    </div>
  </footer>

    drawMatrix();
  </script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --black: #000000;
      --white: #ffffff;
      --gray-dark: #1a1a1a;
      --gray-mid: #666666;
      --gray-light: #cccccc;
      
      --font-heading: "Rajdhani", -apple-system, sans-serif;
      --font-body: "Orbitron", -apple-system, sans-serif;
      --font-mono: "SF Mono", "Monaco", "Courier New", monospace;
    }

    /* Import Cyberpunk-style fonts */
    @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@900&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=ZCOOL+XiaoWei&display=swap');

    body {
      background: var(--white);
      color: var(--black);
      font-family: var(--font-body);
      font-weight: 400;
      line-height: 1.6;
      overflow-x: hidden;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      position: relative;
    }


    /* 墨汁滴落晕染效果 */
    .ink-drop {
      position: fixed;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      pointer-events: none;
      opacity: 0;
    }

    .ink-drop-1 {
      top: 10%;
      left: 20%;
      background: radial-gradient(circle, rgba(0, 0, 0, 0.08) 0%, rgba(0, 0, 0, 0.03) 30%, transparent 70%);
      z-index: 1;
      animation: inkDrop1 15s ease-in-out infinite;
    }

    .ink-drop-2 {
      top: 60%;
      right: 15%;
      background: radial-gradient(circle, rgba(0, 0, 0, 0.06) 0%, rgba(0, 0, 0, 0.02) 30%, transparent 70%);
      z-index: 1;
      animation: inkDrop2 20s ease-in-out infinite 5s;
    }

    @keyframes inkDrop1 {
      0% {
        opacity: 0;
        transform: scale(0.3) translateY(-50px);
      }
      10% {
        opacity: 1;
        transform: scale(0.5) translateY(0);
      }
      50% {
        opacity: 1;
        transform: scale(2.5) translateY(20px);
      }
      100% {
        opacity: 0;
        transform: scale(4) translateY(40px);
      }
    }

    @keyframes inkDrop2 {
      0% {
        opacity: 0;
        transform: scale(0.3) translateY(-50px);
      }
      10% {
        opacity: 1;
        transform: scale(0.5) translateY(0);
      }
      50% {
        opacity: 1;
        transform: scale(2.8) translateY(20px);
      }
      100% {
        opacity: 0;
        transform: scale(4.5) translateY(40px);
      }
    }

    /* Container */
    .container {
      position: relative;
      z-index: 10;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Navigation */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.95);
      border-bottom: 3px solid var(--black);
      backdrop-filter: blur(10px);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1rem;
      font-weight: 700;
      color: var(--black);
      text-decoration: none;
      letter-spacing: 0.25em;
      text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .glitch {
      position: relative;
      display: inline-block;
    }

    /* 篆刻印章 */
    .seal {
      flex-shrink: 0;
    }

    .seal-footer {
    }

    .nav-links {
      display: flex;
      gap: 3rem;
    }

    .nav-links a {
      color: rgba(0, 0, 0, 0.6);
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 400;
      transition: all 0.2s;
    }

    .nav-links a:hover {
      color: var(--black);
    }

    /* Hero */
    .hero {
      position: relative;
      z-index: 10;
      padding: 12rem 0 6rem;
    }

    .hero-badge {
      font-size: 0.875rem;
      color: var(--black);
      margin-bottom: 2rem;
      font-weight: 600;
      position: relative;
      display: inline-block;
      padding-left: 1.5rem;
      border-left: 4px solid var(--black);
      padding-left: 1rem;
    }

    .hero-title {
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 900;
      line-height: 0.95;
      margin-bottom: 2.5rem;
      color: var(--black);
      font-family: var(--font-heading);
      letter-spacing: 0.3em;
      text-shadow: 
        2px 2px 4px rgba(0, 0, 0, 0.2);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    .glitch-text {
      position: relative;
      display: inline-block;
    }

    .cyber-gradient {
      color: var(--black);
      font-weight: 900;
      text-shadow: 
        6px 6px 0px rgba(0, 0, 0, 0.2);
    }

    @keyframes shimmer {
      0% { background-position: 0% center; }
      100% { background-position: 200% center; }
    }

    .hero-subtitle {
      font-size: 1.1rem;
      line-height: 1.8;
      color: rgba(0, 0, 0, 0.75);
      margin-bottom: 2.5rem;
      font-weight: 400;
      letter-spacing: 0.02em;
      text-transform: none;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 1rem 2rem;
      border: 3px solid var(--black);
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.875rem;
      text-decoration: none;
      transition: all 0.15s;
      display: inline-block;
      position: relative;
      letter-spacing: 0.15em;
      box-shadow: 4px 4px 0px var(--black);
    }

    .btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--black);
    }

    .btn-primary {
      background: var(--black);
      color: var(--white);
    }

    .btn-primary:hover {
      background: var(--white);
      color: var(--black);
    }

    .btn-secondary {
      background: var(--white);
      color: var(--black);
    }

    .btn-secondary:hover {
      background: var(--black);
      color: var(--white);
    }

    /* Overview Section */
    .overview-section {
      position: relative;
      z-index: 10;
      padding: 4rem 0 6rem;
    }

    .overview-content {
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
    }

    .overview-text {
      font-size: 1.15rem;
      line-height: 1.8;
      color: rgba(0, 0, 0, 0.8);
      text-transform: none;
      letter-spacing: 0.02em;
      font-weight: 400;
    }

    .overview-text strong {
      color: var(--black);
      font-weight: 600;
    }

    /* Main */
    .main {
      position: relative;
      z-index: 10;
    }

    .section {
      padding: 6rem 0;
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 3rem;
      color: var(--black);
      font-family: var(--font-heading);
      letter-spacing: 0.2em;
      text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.15);
    }

    .section-marker {
      color: var(--black);
      margin-right: 1rem;
      font-weight: 900;
      display: inline-block;
    }

    .section-seal {
      display: inline-block;
      border: 3px solid var(--black);
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
      font-weight: 700;
      margin-left: 1.5rem;
      font-family: 'ZCOOL XiaoWei', 'STKaiti', 'KaiTi', 'Noto Serif SC', serif;
      letter-spacing: 0.3em;
      background: var(--white);
      position: relative;
    }

    .section-seal::before {
      content: '';
      position: absolute;
      top: -3px;
      left: -3px;
      width: 16px;
      height: 16px;
      border-top: 3px solid var(--black);
      border-left: 3px solid var(--black);
    }

    .section-seal::after {
      content: '';
      position: absolute;
      bottom: -3px;
      right: -3px;
      width: 16px;
      height: 16px;
      border-bottom: 3px solid var(--black);
      border-right: 3px solid var(--black);
    }

    /* Grid */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    /* 锐利卡片 */
    .cyber-card {
      padding: 2rem;
      border: 3px solid var(--black);
      background: var(--white);
      position: relative;
      transition: all 0.2s;
      box-shadow: 
        6px 6px 0px var(--black);
    }

    /* 角标装饰 */
    .cyber-card::before {
      content: '';
      position: absolute;
      top: -3px;
      left: -3px;
      width: 20px;
      height: 20px;
      border-top: 4px solid var(--black);
      border-left: 4px solid var(--black);
    }

    .cyber-card::after {
      content: '';
      position: absolute;
      bottom: -3px;
      right: -3px;
      width: 20px;
      height: 20px;
      border-bottom: 4px solid var(--black);
      border-right: 4px solid var(--black);
    }

    .cyber-card:hover {
      transform: translate(-2px, -2px);
      box-shadow: 
        8px 8px 0px var(--black);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .card-id {
      font-size: 0.75rem;
      color: var(--white);
      font-weight: 900;
      background: var(--black);
      padding: 0.25rem 0.5rem;
      line-height: 1;
    }

    .card-status {
      font-size: 0.75rem;
      color: var(--green);
      text-shadow: 0 0 5px var(--green);
    }

    .card-title {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--black);
      font-family: var(--font-heading);
      letter-spacing: 0.15em;
      transform: skewX(-2deg);
      text-shadow: 1px 1px 0px rgba(0, 0, 0, 0.1);
    }

    .card-text {

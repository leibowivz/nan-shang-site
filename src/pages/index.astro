      line-height: 1.7;
      text-transform: none;
      letter-spacing: 0.02em;
      font-weight: 400;
      font-size: 0.95rem;
    }

    /* Systems */
    .systems {
      display: grid;
      gap: 2rem;
    }

    .system-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: var(--green);
      text-shadow: 0 0 5px var(--green);

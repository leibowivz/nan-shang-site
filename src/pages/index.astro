  </footer>

  <script>
    // Satellite Earth Horizon Animation
    const canvas = document.getElementById('horizon-canvas');
    const ctx = canvas.getContext('2d');

    let width, height;
    let time = 0;
    const chars = ['█', '▓', '▒', '░', '▄', '▀'];

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    function getDawnColor(y, offset = 0) {
      // Simulate Earth horizon at dawn - ORIGINAL DEEPER COLORS
      const normalizedY = y / height;
      const position = normalizedY + offset;
      
      if (position < 0.3) {
        // Deep space - dark blue
        const darkness = position / 0.3;
        return `rgba(0, 20, 40, ${darkness * 0.8})`;
      } else if (position < 0.5) {
        // Upper atmosphere - deep blue
        return `rgb(20, 40, 80)`;
      } else if (position < 0.55) {
        // Dawn line - orange/red (original)
        const dawnProgress = (position - 0.5) / 0.05;
        const r = Math.floor(255 - dawnProgress * 80);
        const g = Math.floor(120 + dawnProgress * 50);
        const b = Math.floor(40);
        return `rgb(${r}, ${g}, ${b})`;
      } else if (position < 0.6) {
        // Transition - yellow to cyan (original)
        const transition = (position - 0.55) / 0.05;
        const r = Math.floor(220 - transition * 220);
        const g = Math.floor(180 + transition * 40);
        const b = Math.floor(40 + transition * 180);
        return `rgb(${r}, ${g}, ${b})`;
      } else {
        // Earth surface - cyan (original)
        return `rgb(0, 200, 220)`;
      }
    }

    function drawHorizon() {
      // Clear with trail effect
      ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
      ctx.fillRect(0, 0, width, height);

      ctx.font = '14px "SF Mono", Monaco, monospace';
      ctx.textAlign = 'center';

      const cols = Math.floor(width / 14);
      const rows = Math.floor(height / 20);
      
      // Earth curvature center
      const centerY = height * 0.55;
      const curveRadius = width * 0.8;

      time += 0.008;

      for (let x = 0; x < cols; x++) {
        for (let y = 0; y < rows; y++) {
          const screenX = x * 14;
          const screenY = y * 20;

          // Calculate distance from horizon curve
          const dx = screenX - width / 2;
          const curveY = centerY + Math.sqrt(Math.max(0, curveRadius * curveRadius - dx * dx)) - curveRadius;
          const distanceFromHorizon = screenY - curveY;

          // Only draw near horizon
          if (Math.abs(distanceFromHorizon) < 200) {
            const density = Math.abs(distanceFromHorizon) / 200;
            
            // Wave motion for atmosphere
            const wave = Math.sin(x * 0.1 + time * 2) * 10 + Math.cos(x * 0.07 - time) * 5;
            const adjustedDistance = distanceFromHorizon + wave;

            if (adjustedDistance > -50 && adjustedDistance < 150) {
              const charDensity = Math.abs(adjustedDistance) / 150;
              const charIndex = Math.floor(charDensity * chars.length);
              const char = chars[Math.min(charIndex, chars.length - 1)];

              // Dawn gradient color
              const yOffset = (Math.sin(x * 0.05 + time) * 0.02);
              const color = getDawnColor(screenY, yOffset);
              
              const alpha = 1 - charDensity * 0.7;
              ctx.fillStyle = color;
              ctx.globalAlpha = alpha * 0.6;
              
              ctx.fillText(char, screenX, screenY);
            }
          }
        }
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(drawHorizon);
    }

    window.addEventListener('resize', resize);
    resize();
    drawHorizon();
  </script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --black: #000000;
      --white: #ffffff;
      --cyan: #00f0ff;
      --orange: #ff6b00;
      --red: #ff0055;
      --blue: #0066ff;
      --green: #00ff88;
      --yellow: #ffcc00;
      --gray: #888888;
      
      --font-cyber: "Rajdhani", "Orbitron", "Exo 2", "Share Tech", -apple-system, sans-serif;
      --font-mono: "SF Mono", "Monaco", "Courier New", monospace;
    }

    /* Import Cyberpunk-style font */
    @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&display=swap');

    body {
      background: var(--black);
      color: var(--white);
      font-family: var(--font-cyber);
      font-weight: 400;
      line-height: 1.6;
      overflow-x: hidden;
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }

    /* Canvas */
    #horizon-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      opacity: 0.6;
    }

    /* Scanlines */
    .scanlines {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.15),
        rgba(0, 0, 0, 0.15) 1px,
        transparent 1px,
        transparent 2px
      );
      pointer-events: none;
      z-index: 5;
      opacity: 0.3;
    }

    /* CRT Flicker */
    .crt-flicker {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 240, 255, 0.03);
      pointer-events: none;
      z-index: 4;
      animation: flicker 0.15s infinite;
    }

    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.95; }
    }

    /* Container */
    .container {
      position: relative;
      z-index: 10;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Navigation */
    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(0, 0, 0, 0.95);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1rem;
      font-weight: 700;
      color: var(--white);
      text-decoration: none;
      letter-spacing: 0.25em;
      transform: skewX(-3deg);
      text-shadow: 2px 2px 0px rgba(0, 240, 255, 0.3);
    }

    .glitch {
      position: relative;
      display: inline-block;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
    }

    .nav-links a {
      color: rgba(255, 255, 255, 0.6);
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 400;
      transition: all 0.2s;
    }

    .nav-links a:hover {
      color: var(--white);
    }

    .nav-bracket {
      color: var(--cyan);
      opacity: 0.6;
    }

    /* Hero */
    .hero {
      position: relative;
      z-index: 10;
      padding: 12rem 0 6rem;
    }

    .hero-badge {
      font-size: 0.875rem;
      color: var(--cyan);
      margin-bottom: 2rem;
      text-shadow: 0 0 10px var(--cyan);
      font-weight: 300;
    }

    .terminal-prompt {
      color: var(--cyan);
      text-shadow: 0 0 10px var(--cyan);
    }

    .hero-title {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 2rem;
      color: var(--white);
      letter-spacing: 0.2em;
      transform: skewX(-3deg);
      text-shadow: 
        2px 2px 0px rgba(0, 240, 255, 0.5),
        -1px -1px 0px rgba(255, 0, 255, 0.3);
    }

    .glitch-text {
      position: relative;
      display: inline-block;
    }

    .cyber-gradient {
      background: linear-gradient(90deg,
        var(--cyan) 0%,
        var(--blue) 25%,
        var(--cyan) 50%,
        var(--green) 75%,
        var(--cyan) 100%
      );
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      background-size: 200% auto;
      animation: shimmer 3s linear infinite;
      filter: drop-shadow(0 0 20px var(--cyan));
    }

    @keyframes shimmer {
      0% { background-position: 0% center; }
      100% { background-position: 200% center; }
    }

    .hero-subtitle {
      font-size: 1rem;
      line-height: 2;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 2.5rem;
      font-weight: 400;
      letter-spacing: 0.05em;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 1rem 2rem;
      border: 2px solid;
      font-family: var(--font-cyber);
      font-weight: 700;
      font-size: 0.875rem;
      text-decoration: none;
      transition: all 0.3s;
      display: inline-block;
      position: relative;
      transform: skewX(-2deg);
      letter-spacing: 0.15em;
    }

    .btn-primary {
      background: var(--white);
      color: var(--black);
      border-color: var(--white);
    }

    .btn-primary:hover {
      background: transparent;
      color: var(--white);
    }

    .btn-secondary {
      background: transparent;
      color: var(--white);
      border-color: rgba(255, 255, 255, 0.3);
    }

    .btn-secondary:hover {
      background: var(--white);
      color: var(--black);
    }

    .btn-bracket {
      color: var(--cyan);
      text-shadow: 0 0 5px var(--cyan);
    }

    /* Status Bar */
    .status-bar {
      position: relative;
      z-index: 10;
      padding: 3rem 0;
    }

    .status-grid {
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(0, 0, 0, 0.5);
    }

    .status-item {
      text-align: center;
    }

    .status-label {
      font-size: 0.75rem;
      color: var(--cyan);
      margin-bottom: 0.5rem;
      opacity: 0.7;
    }

    .status-value {
      font-size: 2.5rem;
      font-weight: 900;
    }

    .cyber-number {
      color: var(--white);
      font-weight: 700;
      text-shadow: 
        0 0 10px var(--cyan),
        2px 2px 0px rgba(0, 240, 255, 0.5);
    }

    .cyber-plus, .cyber-slash, .cyber-percent {
      color: var(--orange);
    }

    .status-divider {
      color: var(--cyan);
      font-size: 2rem;
      opacity: 0.3;
    }

    /* Main */
    .main {
      position: relative;
      z-index: 10;
    }

    .section {
      padding: 6rem 0;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 3rem;
      color: var(--white);
      letter-spacing: 0.2em;
      transform: skewX(-2deg);
    }

    .section-marker {
      color: var(--cyan);
      margin-right: 1rem;
      text-shadow: 0 0 10px var(--cyan);
    }

    /* Grid */
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    /* Cyber Card */
    .cyber-card {
      padding: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(0, 0, 0, 0.5);
      position: relative;
      transition: all 0.3s;
    }

    .cyber-card::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      right: -1px;
      bottom: -1px;
      background: rgba(255, 255, 255, 0.1);
      opacity: 0;
      transition: opacity 0.3s;
      z-index: -1;
    }

    .cyber-card:hover {
      border-color: var(--cyan);
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
    }

    .cyber-card:hover::before {
      opacity: 0.5;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
